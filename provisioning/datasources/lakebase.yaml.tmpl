# Template for the Lakebase datasource provisioning file.
# The live file (lakebase.yaml) is written at boot by startup.py
# using lib.grafana_env.render_lakebase_datasource().
# This file documents the rendered shape; do not use it directly.
apiVersion: 1
datasources:
  - name: Lakebase
    type: postgres
    access: proxy
    url: 127.0.0.1:${pgbouncer_port}
    database: ${db_name}
    user: ${client_user}
    isDefault: true
    jsonData:
      sslmode: disable
      postgresVersion: 1500
    secureJsonData:
      password: ${client_password}
