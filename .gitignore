# Deploy-time config filled in with workspace-specific values (Lakebase host,
# service principal UUID, app URL, warehouse path). Copy app.yaml.template to
# app.yaml and fill in the placeholders; keep the real file out of git.
app.yaml

# Runtime artifacts generated by startup.py in the working dir. These contain
# secrets (userlist.txt = loopback password; pgbouncer.ini / lakebase.yaml =
# Lakebase token) and must never be committed or uploaded — startup.py
# regenerates them on every boot.
pgbouncer.ini
userlist.txt
stunnel.conf
pgbouncer.pid
provisioning/datasources/lakebase.yaml
provisioning/datasources/databricks.yaml
provisioning/dashboards/provider.yaml
.coverage
htmlcov/
.mypy_cache/
